<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f3ec" />
    <title>@ViewData["Title"] — Fieldnotes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-nav container">
            <a class="brand" asp-controller="Blog" asp-action="Index" aria-label="Fieldnotes home">
                <span class="brand-mark" aria-hidden="true">F.</span>
                <span>fieldnotes<span class="brand-period">.</span></span>
            </a>
            <div class="nav-right">
                <span class="nav-caption">A journal for curious minds</span>
                <a class="button button-dark nav-cta" asp-controller="Blog" asp-action="Create">
                    Write a story <span aria-hidden="true">↗</span>
                </a>
            </div>
        </nav>
    </header>

    <main class="container page-shell">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <a class="brand footer-brand" asp-controller="Blog" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">F.</span>
                <span>fieldnotes<span class="brand-period">.</span></span>
            </a>
            <span>Made for ideas worth sharing.</span>
        </div>
    </footer>
</body>
</html>
